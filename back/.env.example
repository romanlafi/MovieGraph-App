# Legacy local API only. Load explicitly with uvicorn --env-file .env.
APP_ENV=development
SECRET_KEY=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
# Host PostgreSQL for Uvicorn. In Compose use db:5432 instead of localhost.
DATABASE_URL=postgresql://movieuser:moviepass@localhost:5432/moviedb
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
